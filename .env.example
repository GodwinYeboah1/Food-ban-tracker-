# Vercel Cron sends this automatically as `Authorization: Bearer $CRON_SECRET`
# when it triggers /api/cron/sync-bans. Set it in your Vercel project settings.
# Generate one with: openssl rand -hex 32
CRON_SECRET=replace-with-a-random-secret

# Absolute origin, used for Open Graph and canonical URLs.
NEXT_PUBLIC_SITE_URL=https://your-deployment.vercel.app
